# Environment Configuration Template
# Copy this file to .env and update values for your environment
# DO NOT commit .env file to version control

# Project Configuration
COMPOSE_PROJECT_NAME=bigdata
ENVIRONMENT=development
LOG_LEVEL=info

# Nginx Configuration
NGINX_PORT=80
NGINX_SERVER_NAME=localhost
BACKEND_HOST=backend
BACKEND_INTERNAL_PORT=8000
FRONTEND_HOST=frontend
FRONTEND_INTERNAL_PORT=3000
AIRFLOW_HOST=airflow
AIRFLOW_INTERNAL_PORT=8080

# PostgreSQL Database
POSTGRES_DB=bigdata_db
POSTGRES_USER=bigdata_user
POSTGRES_PASSWORD=bigdata_pass
DATABASE_URL=postgresql+asyncpg://bigdata_user:bigdata_pass@postgres:5432/bigdata_db

# Airflow Database (separate database in same PostgreSQL instance)
AIRFLOW_DB=airflow_db
AIRFLOW_DATABASE_URL=postgresql://bigdata_user:bigdata_pass@postgres:5432/airflow_db

# ClickHouse
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=http://clickhouse:8123/default

# Redis
REDIS_URL=redis://redis:6379/0

# HDFS
HDFS_CLUSTER_NAME=hadoop-cluster
HDFS_NAMENODE_URL=hdfs://namenode:9000

# Backend Configuration (accessed through Nginx on port 80)
BACKEND_EXTERNAL_URL=http://localhost
WEBSOCKET_EXTERNAL_URL=ws://localhost
BACKEND_CORS_ORIGINS=http://localhost,http://frontend:3000

# Frontend Configuration
NODE_ENV=production

# Airflow Configuration
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_FERNET_KEY=lv9mGx11ed56ksPBhVfNSLqwTRFapSFNAjWiOEjU2As=
AIRFLOW_WEBSERVER_SECRET_KEY=your-secret-webserver-key

# PgAdmin (Optional - requires --profile tools)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# SECURITY WARNING:
# Change all default passwords before deploying to production
# Generate secure keys using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"